# Copiază în `.env` (python manage.py setup face asta automat).
# Schema și valorile implicite sunt în app/config.py. Aici stau doar numele variabilelor;
# secretele se completează numai în `.env`, care nu se comite.

# --- Comutatoare mock <-> real ---------------------------------------------
PMS_PROVIDER=mock            # mock | ownerrez | hospitable
LLM_PROVIDER=mock            # mock | openrouter
REVIEWS_PROVIDER=mock        # mock | apify
MARKET_PROVIDER=mock         # mock | inside_airbnb

# --- LLM (LLM_PROVIDER=openrouter) -----------------------------------------
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_MODEL_UTILITY=

# --- Hospitable (PMS_PROVIDER=hospitable) ----------------------------------
HOSPITABLE_API_TOKEN=

# --- OwnerRez (PMS_PROVIDER=ownerrez) --------------------------------------
OWNERREZ_ENV=stage           # stage | production
OWNERREZ_ACCESS_TOKEN=
OWNERREZ_USERNAME=
OWNERREZ_PERSONAL_TOKEN=

# --- Webhook-uri -----------------------------------------------------------
WEBHOOK_TOKEN=
F1_OWNERREZ_WEBHOOK_USERNAME=
F1_OWNERREZ_WEBHOOK_PASSWORD=
F1_HOSPITABLE_WEBHOOK_ALLOW_CIDRS=

# --- Apify (REVIEWS_PROVIDER=apify) ----------------------------------------
APIFY_TOKEN=
APIFY_REVIEWS_ACTOR_ID=
APIFY_REVIEWS_INPUT_TEMPLATE=

# --- Inside Airbnb (MARKET_PROVIDER=inside_airbnb) -------------------------
INSIDE_AIRBNB_LISTINGS_CSV=
MARKET_CITY=
MARKET_CURRENCY=

# F5: fișierul detaliat poate fi plasat în app/adapters/inside_airbnb/local_data/listings.csv.gz.
# Pentru snapshotul Atena: MARKET_CITY=Athens, MARKET_CURRENCY=EUR; păstrează mock ca rezervă.
F5_UNDERCUT_PCT=3
F5_MARKET_TIMEOUT_S=20
F5_CALENDAR_TIMEOUT_S=5
F5_TIMEZONE=Europe/Bucharest

# --- F2 · Incidente (opțional; valorile implicite merg pentru demo) ---------
# Pentru demo, câteva secunde de întârziere fac pașii simulați vizibili.
F2_SIM_ENABLED=              # true (implicit): personalul și oaspetele sunt simulați
F2_SIM_STAFF_DELAY_S=        # 0 implicit; ex. 5
F2_SIM_GUEST_DELAY_S=        # 0 implicit; ex. 8
F2_SIM_TASK_DELAY_S=         # 0 implicit; ex. 10
F2_SIM_GUEST_ANSWER=         # accept (implicit) | stay | off
F2_STAFF_REPLY_TIMEOUT_MIN=  # 30 implicit
F2_GUEST_ANSWER_TIMEOUT_MIN= # 60 implicit
F2_FIX_MARGIN_HOURS=         # 2 implicit
F2_INHOUSE_TOLERABLE_HOURS=  # 3 implicit
