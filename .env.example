# Copiază în `.env` (python manage.py setup face asta automat).
# Schema și valorile implicite sunt în app/config.py. Aici stau doar numele variabilelor;
# secretele se completează numai în `.env`, care nu se comite.

# --- Comutatoare mock <-> real ---------------------------------------------
PMS_PROVIDER=mock            # mock | ownerrez | hospitable
LLM_PROVIDER=mock            # mock | openrouter
REVIEWS_PROVIDER=mock        # mock | apify
MARKET_PROVIDER=mock         # mock | inside_airbnb

# --- LLM (LLM_PROVIDER=openrouter) -----------------------------------------
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_MODEL_UTILITY=

# --- Hospitable (PMS_PROVIDER=hospitable) ----------------------------------
HOSPITABLE_API_TOKEN=

# --- OwnerRez (PMS_PROVIDER=ownerrez) --------------------------------------
OWNERREZ_ENV=stage           # stage | production
OWNERREZ_ACCESS_TOKEN=
OWNERREZ_USERNAME=
OWNERREZ_PERSONAL_TOKEN=

# --- Webhook-uri -----------------------------------------------------------
WEBHOOK_TOKEN=

# --- Apify (REVIEWS_PROVIDER=apify) ----------------------------------------
APIFY_TOKEN=
APIFY_REVIEWS_ACTOR_ID=
APIFY_REVIEWS_INPUT_TEMPLATE=

# --- Inside Airbnb (MARKET_PROVIDER=inside_airbnb) -------------------------
INSIDE_AIRBNB_LISTINGS_CSV=
MARKET_CITY=
MARKET_CURRENCY=
